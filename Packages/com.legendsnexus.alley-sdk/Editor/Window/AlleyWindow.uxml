<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" class="alley-root">
        <ui:VisualElement name="header" class="alley-header">
            <ui:VisualElement name="header-logo" class="alley-logo" />
            <ui:VisualElement class="alley-header-text">
                <ui:Label text="LEGENDS ALLEY" class="alley-title" />
                <ui:Label text="COMMUNITY BOOTH SDK" class="alley-subtitle" />
            </ui:VisualElement>
            <ui:VisualElement class="alley-header-spacer" />
            <ui:Button name="signout-button" text="SIGN OUT" class="alley-button-ghost" />
        </ui:VisualElement>
        <ui:VisualElement class="alley-brand-strip">
            <ui:VisualElement class="alley-strip-seg alley-strip-purple" />
            <ui:VisualElement class="alley-strip-seg alley-strip-pink" />
            <ui:VisualElement class="alley-strip-seg alley-strip-teal" />
        </ui:VisualElement>

        <ui:ScrollView name="content" class="alley-content" horizontal-scroller-visibility="Hidden">
            <ui:VisualElement name="login-card" class="alley-card-shadow alley-card-shadow-purple alley-login-wrap">
                <ui:VisualElement class="alley-card alley-card-purple">
                    <ui:Label text="WELCOME TO THE ALLEY" class="alley-card-title" />
                    <ui:Label name="login-blurb" class="alley-body"
                        text="Sign in with the Discord account that owns your approved community to check and upload your booth." />
                    <ui:VisualElement class="alley-shadow alley-shadow-purple">
                        <ui:Button name="login-button" text="SIGN IN WITH DISCORD" class="alley-button-primary" />
                    </ui:VisualElement>
                    <ui:Button name="login-cancel-button" text="CANCEL" class="alley-button-ghost alley-cancel" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="community-card" class="alley-card-shadow alley-card-shadow-purple">
                <ui:VisualElement class="alley-card alley-card-purple">
                    <ui:VisualElement class="alley-community-row">
                        <ui:VisualElement name="community-logo" class="alley-community-logo" />
                        <ui:VisualElement class="alley-community-text">
                            <ui:Label name="community-name" text="" class="alley-card-title" />
                            <ui:Label name="community-owner" text="" class="alley-muted" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="event-card" class="alley-card-shadow alley-card-shadow-teal">
                <ui:VisualElement class="alley-card alley-card-teal">
                    <ui:Label text="EVENT" class="alley-section-label alley-label-teal" />
                    <ui:DropdownField name="event-dropdown" />
                    <ui:Label name="event-info" text="" class="alley-muted" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="booth-card" class="alley-card-shadow alley-card-shadow-pink">
                <ui:VisualElement class="alley-card alley-card-pink">
                    <ui:Label text="YOUR BOOTH" class="alley-section-label alley-label-pink" />
                    <ui:Label name="no-booth-message" class="alley-body"
                        text="No booth found in the open scene. Add the Legends Booth component to your booth's root object." />
                    <ui:DropdownField name="booth-dropdown" />
                    <ui:VisualElement name="check-wrap" class="alley-shadow alley-shadow-teal">
                        <ui:Button name="check-button" text="CHECK BOOTH" class="alley-button-secondary" />
                    </ui:VisualElement>
                    <ui:VisualElement name="blockers" class="alley-blockers" />
                    <ui:VisualElement name="checklist" class="alley-checklist" />
                    <ui:VisualElement name="upload-wrap" class="alley-shadow alley-shadow-purple">
                        <ui:Button name="upload-button" text="BUILD + UPLOAD" class="alley-button-primary" />
                    </ui:VisualElement>
                    <ui:ProgressBar name="upload-progress" class="alley-progress" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="staff-card" class="alley-card-shadow alley-card-shadow-gold">
                <ui:VisualElement class="alley-card alley-card-gold">
                    <ui:Label text="STAFF TOOLS" class="alley-section-label alley-label-gold" />
                    <ui:Label name="staff-plots-summary" text="" class="alley-body" />
                    <ui:VisualElement class="alley-shadow alley-shadow-purple">
                        <ui:Button name="staff-sync-button" text="SYNC BOOTHS TO PLOTS" class="alley-button-primary alley-button-staff" />
                    </ui:VisualElement>
                    <ui:ScrollView name="staff-log" class="alley-staff-log" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Foldout name="settings-foldout" text="SETTINGS" value="false" class="alley-settings">
                <ui:TextField name="api-base-field" label="Server" />
                <ui:Label name="version-label" text="" class="alley-muted" />
            </ui:Foldout>
        </ui:ScrollView>

        <ui:VisualElement name="status-bar" class="alley-status-bar">
            <ui:VisualElement name="status-ticker" class="alley-ticker" />
            <ui:Label name="status-label" text="" class="alley-status" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
