<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" class="alley-root">
        <ui:VisualElement name="header" class="alley-header">
            <ui:VisualElement name="header-logo" class="alley-logo" />
            <ui:VisualElement class="alley-header-text">
                <ui:Label text="LEGENDS ALLEY" class="alley-title" />
                <ui:Label text="COMMUNITY BOOTH SDK" class="alley-subtitle" />
            </ui:VisualElement>
            <ui:VisualElement class="alley-header-spacer" />
            <ui:Button name="signout-button" text="SIGN OUT" class="alley-button-ghost" />
        </ui:VisualElement>
        <ui:VisualElement class="alley-brand-strip">
            <ui:VisualElement class="alley-strip-seg alley-strip-purple" />
            <ui:VisualElement class="alley-strip-seg alley-strip-pink" />
            <ui:VisualElement class="alley-strip-seg alley-strip-teal" />
        </ui:VisualElement>

        <ui:VisualElement name="navbar" class="alley-navbar">
            <ui:Button name="tab-signin" text="SIGN IN" class="alley-tab alley-tab-pink" />
            <ui:Button name="tab-booth" text="BOOTH" class="alley-tab alley-tab-pink" />
            <ui:Button name="tab-community" text="COMMUNITY" class="alley-tab alley-tab-purple" />
            <ui:Button name="tab-staff" text="STAFF" class="alley-tab alley-tab-gold" />
            <ui:Button name="tab-settings" text="SETTINGS" class="alley-tab alley-tab-teal" />
        </ui:VisualElement>

        <ui:VisualElement name="event-strip" class="alley-event-strip">
            <ui:Label text="EVENT" class="alley-event-strip-label" />
            <ui:DropdownField name="event-dropdown" class="alley-event-dropdown" />
            <ui:Label name="event-info" text="" class="alley-event-info" />
        </ui:VisualElement>

        <ui:ScrollView name="content" class="alley-content" horizontal-scroller-visibility="Hidden">
            <ui:VisualElement name="page-signin" class="alley-page">
                <ui:VisualElement class="alley-card-shadow alley-card-shadow-purple alley-login-wrap">
                    <ui:VisualElement class="alley-card alley-card-purple">
                        <ui:Label text="WELCOME TO THE ALLEY" class="alley-card-title" />
                        <ui:Label name="login-blurb" class="alley-body"
                            text="Sign in with the Discord account that owns your approved community to check and upload your booth." />
                        <ui:VisualElement class="alley-shadow alley-shadow-purple">
                            <ui:Button name="login-button" text="SIGN IN WITH DISCORD" class="alley-button-primary" />
                        </ui:VisualElement>
                        <ui:Button name="login-cancel-button" text="CANCEL" class="alley-button-ghost alley-cancel" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="page-booth" class="alley-page">
                <ui:VisualElement class="alley-card-shadow alley-card-shadow-pink">
                    <ui:VisualElement class="alley-card alley-card-pink">
                        <ui:Label text="YOUR BOOTH" class="alley-section-label alley-label-pink" />
                        <ui:Label name="no-booth-message" class="alley-body"
                            text="No booth found in the open scene. Add the Legends Booth component to your booth's root object." />
                        <ui:DropdownField name="booth-dropdown" />
                        <ui:VisualElement name="check-wrap" class="alley-shadow alley-shadow-teal">
                            <ui:Button name="check-button" text="CHECK BOOTH" class="alley-button-secondary" />
                        </ui:VisualElement>
                        <ui:VisualElement name="blockers" class="alley-blockers" />
                        <ui:VisualElement name="checklist" class="alley-checklist" />
                        <ui:VisualElement name="upload-wrap" class="alley-shadow alley-shadow-purple">
                            <ui:Button name="upload-button" text="BUILD + UPLOAD" class="alley-button-primary" />
                        </ui:VisualElement>
                        <ui:ProgressBar name="upload-progress" class="alley-progress" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="page-community" class="alley-page">
                <ui:VisualElement class="alley-card-shadow alley-card-shadow-purple">
                    <ui:VisualElement class="alley-card alley-card-purple">
                        <ui:Label text="YOUR COMMUNITY" class="alley-section-label alley-label-purple" />
                        <ui:VisualElement class="alley-community-row">
                            <ui:VisualElement name="community-logo" class="alley-community-logo" />
                            <ui:VisualElement class="alley-community-text">
                                <ui:Label name="community-name" text="" class="alley-card-title" />
                                <ui:Label name="community-owner" text="" class="alley-muted" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Button name="logo-button" text="CHANGE LOGO" class="alley-button-ghost alley-logo-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="alley-card-shadow alley-card-shadow-purple">
                    <ui:VisualElement class="alley-card alley-card-purple">
                        <ui:Label text="PROFILE" class="alley-section-label alley-label-purple" />
                        <ui:Label class="alley-body"
                            text="Tell everyone what your community is about. This shows to event staff and on the website." />
                        <ui:Label text="DESCRIPTION" class="alley-field-label" />
                        <ui:TextField name="community-description" multiline="true" class="alley-description-field" />
                        <ui:Label name="description-count" text="" class="alley-count" />
                        <ui:Label text="DISCORD INVITE" class="alley-field-label" />
                        <ui:TextField name="community-invite" />
                        <ui:VisualElement class="alley-shadow alley-shadow-teal">
                            <ui:Button name="profile-save-button" text="SAVE PROFILE" class="alley-button-secondary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="page-staff" class="alley-page">
                <ui:VisualElement class="alley-card-shadow alley-card-shadow-gold">
                    <ui:VisualElement class="alley-card alley-card-gold">
                        <ui:Label text="COMMUNITIES" class="alley-section-label alley-label-gold" />
                        <ui:Label name="staff-communities-summary" text="" class="alley-body" />
                        <ui:ScrollView name="staff-communities" class="alley-community-list" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="alley-card-shadow alley-card-shadow-gold">
                    <ui:VisualElement class="alley-card alley-card-gold">
                        <ui:Label text="BOOTH PLACEMENT" class="alley-section-label alley-label-gold" />
                        <ui:Label name="staff-plots-summary" text="" class="alley-body" />
                        <ui:Label text="BOOTH" class="alley-field-label" />
                        <ui:DropdownField name="place-booth-dropdown" />
                        <ui:Label text="PLOT" class="alley-field-label" />
                        <ui:DropdownField name="place-plot-dropdown" />
                        <ui:VisualElement class="alley-shadow alley-shadow-teal">
                            <ui:Button name="place-button" text="PLACE BOOTH" class="alley-button-secondary" />
                        </ui:VisualElement>
                        <ui:VisualElement class="alley-staff-actions">
                            <ui:VisualElement class="alley-shadow alley-shadow-purple alley-grow">
                                <ui:Button name="staff-sync-button" text="SYNC ALL" class="alley-button-primary alley-button-staff" />
                            </ui:VisualElement>
                            <ui:Button name="randomize-button" text="RANDOMIZE" class="alley-button-ghost alley-randomize" />
                        </ui:VisualElement>
                        <ui:ScrollView name="staff-log" class="alley-staff-log" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="page-settings" class="alley-page">
                <ui:VisualElement class="alley-card-shadow alley-card-shadow-teal">
                    <ui:VisualElement class="alley-card alley-card-teal">
                        <ui:Label text="SETTINGS" class="alley-section-label alley-label-teal" />
                        <ui:TextField name="api-base-field" label="Server" />
                        <ui:Label name="version-label" text="" class="alley-muted" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>

        <ui:VisualElement name="status-bar" class="alley-status-bar">
            <ui:VisualElement name="status-ticker" class="alley-ticker" />
            <ui:Label name="status-label" text="" class="alley-status" />
        </ui:VisualElement>

        <ui:VisualElement name="confirm-overlay" class="alley-overlay">
            <ui:VisualElement name="confirm-sheet" class="alley-sheet">
                <ui:Label text="READY TO UPLOAD?" class="alley-card-title alley-sheet-title" />
                <ui:Label class="alley-body"
                    text="By uploading you confirm you have the rights to everything in this booth and that VRChat Legends may include it in the event world and related media." />
                <ui:Label class="alley-muted"
                    text="The export copy gets event safe tweaks (baked light settings, 3D audio, no reflection probes or directional lights). Your scene objects are not changed." />
                <ui:VisualElement class="alley-sheet-buttons">
                    <ui:VisualElement class="alley-shadow alley-shadow-purple alley-grow">
                        <ui:Button name="confirm-upload-button" text="UPLOAD MY BOOTH" class="alley-button-primary" />
                    </ui:VisualElement>
                    <ui:Button name="confirm-cancel-button" text="NOT YET" class="alley-button-ghost alley-sheet-cancel" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
