.alley-root {
    flex-grow: 1;
    background-color: #0A0A0A;
}

.alley-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 12px 14px;
    background-color: #050505;
}

.alley-logo {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    margin-right: 12px;
    background-color: #0A0A0A;
    border-width: 2px;
    border-color: #6B46C1;
}

.alley-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 4px;
}

.alley-subtitle {
    font-size: 9px;
    color: #FF33A1;
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-top: 1px;
}

.alley-header-spacer {
    flex-grow: 1;
}

.alley-brand-strip {
    flex-direction: row;
    height: 4px;
    flex-shrink: 0;
}

.alley-strip-seg {
    flex-grow: 1;
}

.alley-strip-purple { background-color: #6B46C1; }
.alley-strip-pink { background-color: #FF007A; }
.alley-strip-teal { background-color: #1FD1ED; }

/* top navbar, color coded underline tabs */
.alley-navbar {
    flex-direction: row;
    flex-shrink: 0;
    background-color: #050505;
    border-bottom-width: 2px;
    border-bottom-color: #1B1E23;
}

.alley-tab {
    background-color: rgba(0, 0, 0, 0);
    color: rgba(255, 255, 255, 0.45);
    border-width: 0;
    border-radius: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    padding: 10px 13px 7px 13px;
    margin: 0;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    transition-property: color, border-bottom-color;
    transition-duration: 0.12s;
}

.alley-tab:hover { color: #FFFFFF; }
.alley-tab-active { color: #FFFFFF; }

.alley-tab-pink:hover { border-bottom-color: rgba(255, 0, 122, 0.4); }
.alley-tab-pink.alley-tab-active { border-bottom-color: #FF007A; }
.alley-tab-purple:hover { border-bottom-color: rgba(107, 70, 193, 0.55); }
.alley-tab-purple.alley-tab-active { border-bottom-color: #6B46C1; }
.alley-tab-gold:hover { border-bottom-color: rgba(255, 215, 0, 0.4); }
.alley-tab-gold.alley-tab-active { border-bottom-color: #FFD700; }
.alley-tab-teal:hover { border-bottom-color: rgba(31, 209, 237, 0.4); }
.alley-tab-teal.alley-tab-active { border-bottom-color: #1FD1ED; }

/* global event picker under the navbar */
.alley-event-strip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 8px 14px;
    background-color: #0E1013;
    border-bottom-width: 2px;
    border-bottom-color: #1B1E23;
}

.alley-event-strip-label {
    font-size: 10px;
    color: #1FD1ED;
    letter-spacing: 2px;
    -unity-font-style: bold;
    margin-right: 10px;
}

.alley-event-dropdown {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

.alley-event-strip .unity-base-popup-field__input {
    background-color: #0A0A0A;
    border-width: 2px;
    border-color: #2A2D33;
    border-radius: 0;
    padding: 4px 8px;
    color: #EEEEEE;
    transition-property: border-color;
    transition-duration: 0.12s;
}

.alley-event-strip .unity-base-popup-field__input:hover {
    border-color: #1FD1ED;
}

.alley-event-info {
    color: rgba(255, 255, 255, 0.45);
    font-size: 10px;
    margin-left: 10px;
    flex-shrink: 0;
    white-space: nowrap;
}

.alley-content {
    flex-grow: 1;
    padding: 16px 14px 10px 14px;
}

/* cards sit on a hard offset color block, no soft shadows here */
.alley-card-shadow {
    margin: 4px 0 16px 4px;
}

.alley-card-shadow-purple { background-color: #6B46C1; }
.alley-card-shadow-pink { background-color: #FF007A; }
.alley-card-shadow-teal { background-color: #1FD1ED; }
.alley-card-shadow-gold { background-color: #FFD700; }

.alley-card {
    background-color: #14161A;
    border-width: 2px;
    border-radius: 0;
    padding: 14px;
    translate: -4px -4px;
}

.alley-card-purple { border-color: #6B46C1; }
.alley-card-pink { border-color: #FF007A; }
.alley-card-teal { border-color: #1FD1ED; }
.alley-card-gold { border-color: #FFD700; }

.alley-login-wrap {
    margin-top: 28px;
}

.alley-card-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.alley-section-label {
    font-size: 10px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.alley-label-teal { color: #1FD1ED; }
.alley-label-pink { color: #FF33A1; }
.alley-label-gold { color: #FFD700; }
.alley-label-purple { color: #805AD5; }

.alley-body {
    color: #C9CDD3;
    white-space: normal;
    margin-bottom: 8px;
}

.alley-muted {
    color: rgba(255, 255, 255, 0.45);
    white-space: normal;
    margin-top: 4px;
}

/* buttons pop out of their shadow block and slam flat when pressed */
.alley-shadow {
    margin: 11px 0 3px 3px;
}

.alley-shadow-purple { background-color: #6B46C1; }
.alley-shadow-teal { background-color: #1FD1ED; }

.alley-button-primary {
    background-color: #FF007A;
    color: #050505;
    border-width: 0;
    border-radius: 0;
    padding: 10px 14px;
    margin: 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    translate: -3px -3px;
    transition-property: translate, background-color;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

.alley-button-primary:hover {
    background-color: #FF33A1;
    translate: -5px -5px;
}

.alley-button-primary:active {
    background-color: #D60067;
    translate: 0 0;
}

.alley-button-primary:disabled {
    background-color: #23262B;
    color: rgba(255, 255, 255, 0.35);
    translate: 0 0;
}

.alley-button-staff {
    background-color: #FFD700;
}

.alley-button-staff:hover {
    background-color: #FFE44D;
    translate: -5px -5px;
}

.alley-button-staff:active {
    background-color: #E0BD00;
    translate: 0 0;
}

.alley-button-secondary {
    background-color: #14161A;
    color: #6AE3F9;
    border-width: 2px;
    border-color: #1FD1ED;
    border-radius: 0;
    padding: 8px 12px;
    margin: 0;
    -unity-font-style: bold;
    letter-spacing: 1px;
    translate: -3px -3px;
    transition-property: translate, background-color, color;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

.alley-button-secondary:hover {
    background-color: #1FD1ED;
    color: #050505;
    translate: -5px -5px;
}

.alley-button-secondary:active {
    translate: 0 0;
}

.alley-button-secondary:disabled {
    color: rgba(255, 255, 255, 0.3);
    border-color: #2A2D33;
    translate: 0 0;
}

.alley-button-ghost {
    background-color: rgba(0, 0, 0, 0);
    color: rgba(255, 255, 255, 0.6);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 0;
    padding: 5px 10px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    transition-property: color, border-color, background-color;
    transition-duration: 0.12s;
}

.alley-button-ghost:hover {
    color: #FF33A1;
    border-color: #FF007A;
    background-color: rgba(255, 0, 122, 0.08);
}

.alley-refresh {
    margin-left: 6px;
}

.alley-refresh:hover {
    color: #6AE3F9;
    border-color: #1FD1ED;
    background-color: rgba(31, 209, 237, 0.08);
}

.alley-cancel {
    margin-top: 8px;
    align-self: center;
}

.alley-community-row {
    flex-direction: row;
    align-items: center;
}

.alley-community-logo {
    width: 48px;
    height: 48px;
    margin-right: 12px;
    background-color: #0A0A0A;
    border-width: 2px;
    border-color: #6B46C1;
}

.alley-community-text {
    flex-shrink: 1;
}

.alley-logo-button {
    align-self: flex-start;
    margin-top: 10px;
}

/* dropdowns and text inputs, hard edges */
.alley-card .unity-base-popup-field__input {
    background-color: #0A0A0A;
    border-width: 2px;
    border-color: #2A2D33;
    border-radius: 0;
    padding: 5px 8px;
    color: #EEEEEE;
    transition-property: border-color;
    transition-duration: 0.12s;
}

.alley-card .unity-base-popup-field__input:hover {
    border-color: #1FD1ED;
}

.alley-checklist {
    margin-top: 10px;
}

.alley-check-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 5px 8px;
    margin-bottom: 3px;
    background-color: #0E1013;
    border-left-width: 3px;
    border-left-color: #2A2D33;
}

.alley-check-pass { border-left-color: #1FD1ED; }
.alley-check-warn { border-left-color: #FFD700; }
.alley-check-fail { border-left-color: #FF007A; }

.alley-check-label {
    color: #C9CDD3;
    font-size: 11px;
}

.alley-check-value {
    -unity-font-style: bold;
    font-size: 11px;
}

.alley-check-pass .alley-check-value { color: #1FD1ED; }
.alley-check-warn .alley-check-value { color: #FFD700; }
.alley-check-fail .alley-check-value { color: #FF33A1; }

.alley-check-hint {
    color: #FF33A1;
    white-space: normal;
    padding: 2px 8px 6px 11px;
    font-size: 10px;
}

.alley-blockers {
    margin-top: 8px;
}

/* blockers are loud on purpose */
.alley-blocker-row {
    color: #050505;
    -unity-font-style: bold;
    white-space: normal;
    padding: 8px 10px;
    margin-bottom: 6px;
    background-color: #FF007A;
    border-width: 2px;
    border-color: #FF33A1;
    border-radius: 0;
}

.alley-progress {
    margin-top: 10px;
    height: 18px;
}

.alley-progress .unity-progress-bar__background {
    background-color: #0A0A0A;
    border-width: 2px;
    border-color: #FF007A;
    border-radius: 0;
}

.alley-progress .unity-progress-bar__progress {
    background-color: #FF007A;
    border-radius: 0;
    margin: 0;
}

.alley-status-bar {
    background-color: #050505;
    border-top-width: 2px;
    border-top-color: #6B46C1;
    flex-shrink: 0;
}

/* busy indicator, a pink segment running along the status bar border */
.alley-ticker {
    position: absolute;
    top: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background-color: #FF007A;
    display: none;
}

.alley-status {
    padding: 7px 14px;
    color: rgba(255, 255, 255, 0.65);
    font-size: 11px;
    white-space: normal;
}

.alley-settings {
    margin: 4px 0 8px 4px;
    color: rgba(255, 255, 255, 0.6);
}

.alley-card .unity-base-field__label {
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
    min-width: 60px;
}

.alley-card .unity-base-text-field__input {
    background-color: #0A0A0A;
    border-width: 2px;
    border-color: #2A2D33;
    border-radius: 0;
    padding: 4px 8px;
    color: #EEEEEE;
    transition-property: border-color;
    transition-duration: 0.12s;
}

.alley-card .unity-base-text-field__input:focus {
    border-color: #1FD1ED;
}

.alley-staff-log {
    max-height: 180px;
    margin-top: 10px;
    background-color: #0A0A0A;
    border-width: 2px;
    border-color: #23262B;
    padding: 8px;
}

.alley-staff-log-line {
    color: rgba(255, 255, 255, 0.75);
    white-space: normal;
    font-size: 11px;
    margin-bottom: 3px;
}

/* profile editor bits */
.alley-field-label {
    font-size: 9px;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 2px;
    -unity-font-style: bold;
    margin: 8px 0 3px 0;
}

.alley-description-field .unity-base-text-field__input {
    min-height: 72px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.alley-count {
    color: rgba(255, 255, 255, 0.3);
    font-size: 9px;
    -unity-text-align: middle-right;
    margin-top: 2px;
}

/* staff community roster */
.alley-community-list {
    max-height: 190px;
    margin-top: 4px;
}

.alley-community-item {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin-bottom: 4px;
    background-color: #0E1013;
    border-left-width: 3px;
    border-left-color: #FFD700;
}

.alley-community-item-logo {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    margin-right: 8px;
    background-color: #0A0A0A;
    border-width: 1px;
    border-color: #2A2D33;
}

.alley-community-item-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.alley-community-item-name {
    -unity-font-style: bold;
    color: #FFFFFF;
    font-size: 11px;
}

.alley-community-item-desc {
    color: rgba(255, 255, 255, 0.45);
    font-size: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* placement action row */
.alley-staff-actions {
    flex-direction: row;
    align-items: flex-end;
}

.alley-grow {
    flex-grow: 1;
}

.alley-randomize {
    margin-left: 10px;
    margin-bottom: 3px;
    align-self: flex-end;
}

/* upload confirm, darkened backdrop with a bottom sheet */
.alley-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(2, 2, 4, 0.72);
    display: none;
    justify-content: flex-end;
}

.alley-sheet {
    background-color: #14161A;
    border-top-width: 3px;
    border-top-color: #FF007A;
    padding: 16px 16px 14px 16px;
}

.alley-sheet-title {
    margin-bottom: 6px;
}

.alley-sheet-buttons {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 12px;
}

.alley-sheet-cancel {
    margin-left: 10px;
    margin-bottom: 3px;
}
